{
  "name": "home-webgl-viewer",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --base-href ./",
    "test:viewer": "node tests/viewer.cjs",
    "test:walls": "node --experimental-strip-types tests/wall-visibility.mjs",
    "test:walk": "node --experimental-strip-types tests/walk-motion.mjs",
    "test:roaming": "node tests/roaming.cjs",
    "test:cloud:sql": "node tests/supabase-sql.mjs",
    "test:cloud": "node tests/cloud-schemes.cjs",
    "test:autosave": "node tests/autosave-debounce.cjs",
    "mcp": "node --experimental-strip-types mcp/server.mjs",
    "simulate:designs": "node --experimental-strip-types tools/simulate-designs.mjs",
    "test:design": "node --experimental-strip-types --test tests/design-engine.mjs tests/design-mcp.mjs",
    "test:design:ui": "node tests/design-studio.cjs",
    "serve:local": "node --experimental-strip-types serve.mjs dist/home-viewer/browser 8790"
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.116.0",
    "rxjs": "7.8.2",
    "three": "0.186.0",
    "tslib": "2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@electric-sql/pglite": "^0.5.8",
    "@types/three": "0.186.0",
    "playwright": "1.58.2",
    "typescript": "6.0.3"
  }
}
